# =============================================================================
#  CourseHub 本地依赖（docker compose）的环境变量模板
# -----------------------------------------------------------------------------
#  使用方法：
#    1. 把本文件复制一份，重命名为  .env   （就放在同一个目录）
#    2. 把下面的 change_me_xxx 改成你自己的密码
#    3. 执行  docker compose up -d
#
#  ⚠️ .env 已被 .gitignore 忽略，不会提交到 Git。
#     本文件（.env.example）是模板，会随代码一起提交，所以里面**不能填真密码**。
# =============================================================================

# MySQL root 密码（建议 16 位以上，大小写 + 数字 + 符号）
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password

# Redis 密码
REDIS_PASSWORD=change_me_redis_password

# MinIO 账号（预留服务，当前项目未启用，可以不改）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
