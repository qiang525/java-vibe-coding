# =============================================================================
#  本地私有配置模板
# -----------------------------------------------------------------------------
#  使用方法：
#    1. 把本文件复制一份，重命名为 application-local.yml
#    2. 填入你本机的数据库 / Redis 密码
#    3. application-local.yml 已被 .gitignore 忽略，不会被提交到 GitHub
#
#  为什么密码不写在 application-dev.yml：
#    因为那个文件要上传 GitHub。密码写在那里等于公开泄露。
# =============================================================================
spring:
  datasource:
    # 改成你本机 MySQL 的 root 密码
    password: 你的MySQL密码
  redis:
    # Redis 没有设密码就留空字符串 ""
    password: ""
