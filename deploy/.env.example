# =============================================================================
#  生产环境变量模板
# -----------------------------------------------------------------------------
#  使用方法：
#    1. 复制这个文件为 deploy/.env
#    2. 把所有 change_me 改成你自己的强密码
#    3. ⚠️ deploy/.env 已被 gitignore，绝对不会被提交到仓库
# =============================================================================

# MySQL root 密码（建议 16 位以上，大小写+数字+符号）
MYSQL_ROOT_PASSWORD=change_me_mysql_password

# Redis 密码
REDIS_PASSWORD=change_me_redis_password

# JWT 签名密钥
# ⚠️ 至少 32 位（HS256 算法要求），且必须保密
# 可以用这条命令生成一个：openssl rand -base64 48
JWT_SECRET=change_me_at_least_32_characters_long_random_string

# 后端对外地址（用于日志和回调，一般不用改）
APP_BASE_URL=http://localhost
